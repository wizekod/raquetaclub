# ─────────────────────────────────────────────────────────────
# RaquetaClub — variables de entorno
# Copia este archivo a .env.local y rellena los valores reales.
# NUNCA pongas valores reales aquí ni commitees .env.local
# ─────────────────────────────────────────────────────────────

# ── Supabase ────────────────────────────────────────────────
# Project Settings → API
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
# Project Settings → API → service_role (SECRETO, solo server-side)
SUPABASE_SERVICE_ROLE_KEY=

# ── Stripe (suscripción SaaS club → Carlos) ─────────────────
STRIPE_SECRET_KEY=
NEXT_PUBLIC_STRIPE_PUBLISHABLE_KEY=
# Developers → Webhooks → signing secret del endpoint /api/webhooks/stripe
STRIPE_WEBHOOK_SECRET=

# ── Resend (email transaccional) ───────────────────────────
RESEND_API_KEY=
# Remitente verificado en Resend, ej. "RaquetaClub <avisos@raquetaclub.com>"
RESEND_FROM_EMAIL=

# ── WhatsApp (Cloud API de Meta) ───────────────────────────
# Plantillas a aprobar: lib/notifications/whatsapp.ts (WHATSAPP_TEMPLATES)
WHATSAPP_ACCESS_TOKEN=
WHATSAPP_PHONE_NUMBER_ID=
WHATSAPP_TEMPLATE_LANG=
WHATSAPP_WEBHOOK_VERIFY_TOKEN=
WHATSAPP_APP_SECRET=

# ── Cloudflare Turnstile (anti-spam registro público) ──────
NEXT_PUBLIC_TURNSTILE_SITE_KEY=
TURNSTILE_SECRET_KEY=

# ── Notificaciones push (Web Push) ─────────────────────────
# Genera el par una vez: npx web-push generate-vapid-keys
NEXT_PUBLIC_VAPID_PUBLIC_KEY=
VAPID_PRIVATE_KEY=
VAPID_SUBJECT=https://raquetaclub.com

# ── App ────────────────────────────────────────────────────
NEXT_PUBLIC_APP_URL=http://localhost:3000
# Secreto compartido para /api/cron/* (lo llama pg_cron vía pg_net)
CRON_SECRET=
